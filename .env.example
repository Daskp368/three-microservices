# Образец настроек без действующих учетных данных.
# Order, Inventory и Notification импортируют свои файлы из каталога .env в корне проекта.
# В приватных файлах задаются учетные данные основной и тестовой баз.
# Папка .env/ исключена из Git.
# Остальные параметры можно передавать через environment.
SERVICE_BIND_ADDRESS=127.0.0.1
ORDER_HTTP_PORT=8081
INVENTORY_HTTP_PORT=8082
NOTIFICATION_HTTP_PORT=8083

# Для Docker Compose скопируйте файл в игнорируемый Git путь:
# cp .env.example .env/compose.properties
# Затем заполните пароли и JWT_SECRET и запускайте Compose с:
# docker compose --env-file .env/compose.properties up --build

ORDER_DB_URL=jdbc:postgresql://localhost:5433/order_db
ORDER_DB_USERNAME=order_user
ORDER_DB_PASSWORD=
ORDER_TEST_DB_URL=jdbc:postgresql://localhost:5433/order_test_db
ORDER_TEST_DB_USERNAME=order_user
ORDER_TEST_DB_PASSWORD=
INVENTORY_DB_URL=jdbc:postgresql://localhost:5434/inventory_db
INVENTORY_DB_USERNAME=inventory_user
INVENTORY_DB_PASSWORD=
INVENTORY_TEST_DB_URL=jdbc:postgresql://localhost:5434/inventory_test_db
INVENTORY_TEST_DB_USERNAME=inventory_user
INVENTORY_TEST_DB_PASSWORD=
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5435/notification_db
NOTIFICATION_DB_USERNAME=notification_user
NOTIFICATION_DB_PASSWORD=
NOTIFICATION_TEST_DB_URL=jdbc:postgresql://localhost:5435/notification_test_db
NOTIFICATION_TEST_DB_USERNAME=notification_user
NOTIFICATION_TEST_DB_PASSWORD=
INVENTORY_GRPC_HOST=localhost
INVENTORY_GRPC_PORT=9090
INVENTORY_GRPC_DEADLINE=2s
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
NOTIFICATION_KAFKA_GROUP_ID=notification-service
NOTIFICATION_KAFKA_LISTENER_ENABLED=true
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
LOCAL_ADMIN_ENABLED=false
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_EMAIL=admin@example.test
LOCAL_ADMIN_PASSWORD=
